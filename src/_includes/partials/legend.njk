<section class="legend" id="legend" aria-labelledby="legend-name">
  <h2 class="legend__title" id="legend-name"><span lang="en">What the signs mean</span><span lang="es">Qué significan los signos</span></h2>
  <dl class="legend__list">
  {%- for c in categories %}
    <div class="legend__item">
      <dt><span class="legend__sign" data-glyph="{{ c.key }}" aria-hidden="true"></span><span lang="en">{{ c.en }}</span><span lang="es">{{ c.es }}</span></dt>
      <dd><span lang="en">{{ c.desc_en }}</span><span lang="es">{{ c.desc_es }}</span></dd>
    </div>
  {%- endfor %}
  </dl>
</section>
